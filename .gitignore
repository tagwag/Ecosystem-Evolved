# Project exclude paths
/out/
__pycache__/
*.pyc
python/runs/

# GPU setup (Windows)
python/.venv/
python/*_log.txt
python/*.flag

# local GPU quiet-mode setting (per machine)
python/gpu_throttle.txt

# engine / equilibrium run outputs (big; charts + stats are kept)
python/engine/results/*.json
python/equilibrium/results/*.json
python/engine/run_log.txt
python/equilibrium/eq_log.txt
python/engine/configs/_gui_check.toml

# live view / replay / snapshot data (big, per machine)
python/remote/live/
python/remote/replays/
python/equilibrium/snapshots/
python/remote/watcher_log.txt

# engine checkpoints + family-tree logs, toy checkpoints (big)
python/engine/results/*_ckpt/
python/engine/results/*_tree/
python/toybrain/checkpoints/
